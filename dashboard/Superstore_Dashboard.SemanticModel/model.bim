        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Orders[sales])",
            "formatString": "$#,0",
            "displayFolder": "KPIs",
            "lineageTag": "536752fb-9ef4-4929-ba1b-bfe13a851716"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(Orders[profit])",
            "formatString": "$#,0",
            "displayFolder": "KPIs",
            "lineageTag": "8e4ee48a-ead5-4c06-998a-be3822f1e8ea"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Total Profit], [Total Sales])",
            "formatString": "0.0%",
            "displayFolder": "KPIs",
            "lineageTag": "69122c5e-7893-42d6-b8d0-347f98a05c2f"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(Orders[order_id])",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "lineageTag": "9b67cbe6-ac30-4ce4-8e1d-70fc45f7daf7"
          },
          {
            "name": "Total Customers",
            "expression": "DISTINCTCOUNT(Orders[customer_id])",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "lineageTag": "e344b208-bd38-4cdc-b803-5aab0039c290"
          },
          {
            "name": "Total Quantity",
            "expression": "SUM(Orders[quantity])",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "lineageTag": "695c88b7-161a-4b59-8cbc-3ed6d873779c"
          },
          {
            "name": "Avg Discount",
            "expression": "AVERAGE(Orders[discount])",
            "formatString": "0.0%",
            "displayFolder": "KPIs",
            "lineageTag": "df5ba6b8-6eb7-4a04-96a0-c55563ebf666"
          },
          {
            "name": "Returned Orders",
            "expression": "CALCULATE(DISTINCTCOUNT(Orders[order_id]), Orders[is_returned] = 1)",
            "formatString": "#,0",
            "displayFolder": "Returns & Shipping",
            "lineageTag": "eba87b73-f500-4bd5-b4d7-925b171fcc63"
          },
          {
            "name": "Return Rate %",
            "expression": "DIVIDE([Returned Orders], [Total Orders])",
            "formatString": "0.0%",
            "displayFolder": "Returns & Shipping",
            "lineageTag": "ea7b6d87-53b8-420a-9b73-e20cd335c40c"
          },
          {
            "name": "Avg Days to Ship",
            "expression": "AVERAGE(Orders[days_to_ship])",
            "formatString": "0.0",
            "displayFolder": "Returns & Shipping",
            "lineageTag": "ae80688f-5de7-460f-ab77-8020785e3d4e"
          },
          {
            "name": "Sales PY",
            "expression": "CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))",
            "formatString": "$#,0",
            "displayFolder": "Time Intelligence",
            "lineageTag": "dd07d2a3-3b41-4b8b-8a82-8b6453add483"
          },
          {
            "name": "Sales YoY %",
            "expression": "VAR PY = [Sales PY] RETURN IF(NOT ISBLANK(PY), DIVIDE([Total Sales] - PY, PY))",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Time Intelligence",
            "lineageTag": "8dd7bb8b-7f58-4cdb-a3eb-c828f335ba2a"
          },
          {
            "name": "Profit YoY %",
            "expression": "VAR PY = CALCULATE([Total Profit], SAMEPERIODLASTYEAR('Date'[Date])) RETURN IF(NOT ISBLANK(PY), DIVIDE([Total Profit] - PY, ABS(PY)))",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Time Intelligence",
            "lineageTag": "6ecf67f5-a770-4182-8e04-0e42764a11a2"
          },
          {
            "name": "Top 10 Product Sales",
            "expression": "IF(ISINSCOPE(Orders[product_name]), VAR R = RANKX(ALLSELECTED(Orders[product_name]), [Total Sales], , DESC) RETURN IF(R <= 10, [Total Sales]))",
            "formatString": "$#,0",
            "displayFolder": "Ranking",
            "lineageTag": "ce9a91b7-93ab-4ace-8903-400e17a1f4a3"
          },
          {
            "name": "Profit Gain",
            "expression": "VAR P = [Total Profit] RETURN IF(P >= 0, P)",
            "formatString": "$#,0",
            "displayFolder": "KPIs",
            "lineageTag": "41a02d58-2d7d-4152-b287-d51bc1ffbacc"
          },
          {
            "name": "Profit Loss",
            "expression": "VAR P = [Total Profit] RETURN IF(P < 0, P)",
            "formatString": "$#,0",
            "displayFolder": "KPIs",
            "lineageTag": "cca75d0a-3cda-4bee-b7b9-3b583ab3155e"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // 1) Try the Excel file at the FilePath parameter; 2) if it is not there, use the copy of the same data embedded below.",
                "    FromFile = try Table.Buffer(Excel.Workbook(File.Contents(FilePath), null, true){[Item=\"Superstore\",Kind=\"Sheet\"]}[Data]) otherwise null,",
                "    Embedded = Table.PromoteHeaders(Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Source = if FromFile <> null then FromFile else Embedded,",
                "    Selected = Table.SelectColumns(Source, {\"row_id\", \"order_id\", \"order_date\", \"ship_date\", \"ship_mode\", \"customer_id\", \"customer_name\", \"segment\", \"city\", \"state\", \"postal_code\", \"region\", \"product_id\", \"category\", \"sub_category\", \"product_name\", \"sales\", \"quantity\", \"discount\", \"profit\", \"order_year\", \"order_month\", \"days_to_ship\", \"discount_band\", \"is_returned\", \"region_manager\"}),",
                "    AsText = Table.TransformColumnTypes(Selected, {{\"postal_code\", type text}}),",
                "    Typed = Table.TransformColumnTypes(AsText, {{\"row_id\", Int64.Type}, {\"order_id\", type text}, {\"order_date\", type date}, {\"ship_date\", type date}, {\"ship_mode\", type text}, {\"customer_id\", type text}, {\"customer_name\", type text}, {\"segment\", type text}, {\"city\", type text}, {\"state\", type text}, {\"postal_code\", type text}, {\"region\", type text}, {\"product_id\", type text}, {\"category\", type text}, {\"sub_category\", type text}, {\"product_name\", type text}, {\"sales\", type number}, {\"quantity\", Int64.Type}, {\"discount\", type number}, {\"profit\", type number}, {\"order_year\", Int64.Type}, {\"order_month\", type text}, {\"days_to_ship\", Int64.Type}, {\"discount_band\", type text}, {\"is_returned\", Int64.Type}, {\"region_manager\", type text}}, \"en-US\"),",
                "    BandOrder = Table.AddColumn(Typed, \"discount_band_order\", each if [discount_band] = \"0%\" then 1 else if [discount_band] = \"1-10%\" then 2 else if [discount_band] = \"11-20%\" then 3 else if [discount_band] = \"21-30%\" then 4 else if [discount_band] = \"31-50%\" then 5 else 6, Int64.Type)",
                "in",
                "    BandOrder"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
